// This is your Prisma schema file
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(uuid())
  name              String
  email             String    @unique
  phone             String?
  password          String
  state             String?
  district          String?
  preferredLanguage String    @default("en")
  avatarUrl         String?
  role              Role      @default(FARMER)
  isVerified        Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  farms                 Farm[]
  cropRecommendations   CropRecommendation[]
  diseaseDetections     DiseaseDetection[]
  notifications         Notification[]
  savedSchemes          SavedScheme[]
  soilReadings          SoilReading[]

  @@map("users")
}

enum Role {
  FARMER
  EXPERT
  ADMIN
}

model Farm {
  id             String   @id @default(uuid())
  userId         String
  name           String
  area           Float
  areaUnit       String   @default("acres")
  state          String
  district       String
  village        String?
  soilType       String?
  irrigationType String?
  latitude       Float?
  longitude      Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  crops        Crop[]
  soilReadings SoilReading[]

  @@map("farms")
}

model Crop {
  id              String    @id @default(uuid())
  farmId          String
  name            String
  variety         String?
  plantingDate    DateTime?
  expectedHarvest DateTime?
  actualHarvest   DateTime?
  status          CropStatus @default(GROWING)
  healthScore     Int?
  area            Float?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@map("crops")
}

enum CropStatus {
  PLANNED
  GROWING
  HARVESTED
  FAILED
}

model SoilReading {
  id          String   @id @default(uuid())
  farmId      String
  userId      String
  nitrogen    Float?
  phosphorus  Float?
  potassium   Float?
  ph          Float?
  moisture    Float?
  temperature Float?
  organicMatter Float?
  recordedAt  DateTime @default(now())
  source      String   @default("manual")
  createdAt   DateTime @default(now())

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("soil_readings")
}

model WeatherRecord {
  id           String   @id @default(uuid())
  location     String
  latitude     Float?
  longitude    Float?
  temperature  Float?
  feelsLike    Float?
  humidity     Float?
  windSpeed    Float?
  windDir      Float?
  rainfall     Float?
  pressure     Float?
  uvIndex      Float?
  description  String?
  icon         String?
  recordedAt   DateTime @default(now())

  @@map("weather_records")
}

model CropRecommendation {
  id          String   @id @default(uuid())
  userId      String
  nitrogen    Float
  phosphorus  Float
  potassium   Float
  ph          Float
  temperature Float
  humidity    Float
  rainfall    Float
  soilType    String?
  season      String?
  location    String?
  results     Json
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("crop_recommendations")
}

model DiseaseDetection {
  id             String   @id @default(uuid())
  userId         String
  imageUrl       String
  diseaseName    String?
  plantName      String?
  confidence     Float?
  symptoms       String[]
  causes         String[]
  treatments     String[]
  prevention     String[]
  severity       String?
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("disease_detections")
}

model MarketPrice {
  id          String   @id @default(uuid())
  crop        String
  state       String
  district    String
  market      String
  minPrice    Float
  maxPrice    Float
  modalPrice  Float
  unit        String   @default("quintal")
  priceDate   DateTime
  createdAt   DateTime @default(now())

  @@map("market_prices")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  title     String
  message   String
  type      NotificationType
  isRead    Boolean          @default(false)
  data      Json?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

enum NotificationType {
  WEATHER_ALERT
  DISEASE_RISK
  MARKET_PRICE
  SCHEME_DEADLINE
  IRRIGATION_REMINDER
  CROP_ADVISORY
  SYSTEM
}

model SavedScheme {
  id        String   @id @default(uuid())
  userId    String
  schemeId  String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("saved_schemes")
}
